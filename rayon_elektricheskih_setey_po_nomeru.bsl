// Соответствие: № (из 1-го списка) -> Справочник.ЭЭ_РайоныЭлектрическихСетей.
// Код из 2-й таблицы используется только для поиска элемента справочника.
// Ключ — число, значение — ссылка. Если элемент с кодом не найден — ПустаяСсылка.

Функция СоответствиеРайоновЭлектрическихСетей() Экспорт

	КодыПоНомерам = Новый Соответствие;
	КодыПоНомерам.Вставить(2,  "012");
	КодыПоНомерам.Вставить(3,  "003");
	КодыПоНомерам.Вставить(4,  "007");
	КодыПоНомерам.Вставить(5,  "008");
	КодыПоНомерам.Вставить(7,  "058");
	КодыПоНомерам.Вставить(8,  "027");
	КодыПоНомерам.Вставить(9,  "023");
	КодыПоНомерам.Вставить(10, "999");
	КодыПоНомерам.Вставить(11, "026");
	КодыПоНомерам.Вставить(12, "025");
	КодыПоНомерам.Вставить(13, "010");
	КодыПоНомерам.Вставить(14, "032");
	КодыПоНомерам.Вставить(15, "033");
	КодыПоНомерам.Вставить(16, "034");
	КодыПоНомерам.Вставить(18, "004");
	КодыПоНомерам.Вставить(19, "005");
	КодыПоНомерам.Вставить(20, "024");
	КодыПоНомерам.Вставить(21, "022");
	КодыПоНомерам.Вставить(23, "021");
	КодыПоНомерам.Вставить(24, "035");
	КодыПоНомерам.Вставить(25, "015");
	КодыПоНомерам.Вставить(26, "009");
	КодыПоНомерам.Вставить(27, "117");

	Коды = Новый Массив;
	Для Каждого Элемент Из КодыПоНомерам Цикл
		Коды.Добавить(Элемент.Значение);
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Районы.Ссылка КАК Ссылка,
		|	Районы.Код КАК Код
		|ИЗ
		|	Справочник.ЭЭ_РайоныЭлектрическихСетей КАК Районы
		|ГДЕ
		|	Районы.Код В (&Коды)";
	Запрос.УстановитьПараметр("Коды", Коды);

	СсылкиПоКодам = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СсылкиПоКодам.Вставить(Выборка.Код, Выборка.Ссылка);
	КонецЦикла;

	ПустойРайон = Справочники.ЭЭ_РайоныЭлектрическихСетей.ПустаяСсылка();

	РайоныПоНомерам = Новый Соответствие;
	Для Каждого Элемент Из КодыПоНомерам Цикл
		Ссылка = СсылкиПоКодам.Получить(Элемент.Значение);
		РайоныПоНомерам.Вставить(Элемент.Ключ, ?(Ссылка = Неопределено, ПустойРайон, Ссылка));
	КонецЦикла;

	Возврат РайоныПоНомерам;

КонецФункции

// Соответствие: Справочник.ЭЭ_РайоныЭлектрическихСетей -> Справочник.УТП_МуниципальныеОбразования.
// Ключи — районы из СоответствиеРайоновЭлектрическихСетей(), значение — муниципальное образование,
// у которого реквизит РайонЭлектросетей равен ключу. Если такого нет — ПустаяСсылка.
// Если на район приходится несколько муниципальных образований, берётся первое по наименованию.

Функция СоответствиеМуниципальныхОбразованийПоРайонам() Экспорт
	
	Районы = Новый Массив;
	Для Каждого Элемент Из СоответствиеРайоновЭлектрическихСетей() Цикл
		Если ЗначениеЗаполнено(Элемент.Значение) Тогда
			Районы.Добавить(Элемент.Значение);
		КонецЕсли;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	МО.Ссылка КАК Ссылка,
		|	МО.РайонЭлектросетей КАК РайонЭлектросетей
		|ИЗ
		|	Справочник.УТП_МуниципальныеОбразования КАК МО
		|ГДЕ
		|	МО.РайонЭлектросетей В (&Районы)
		|	И НЕ МО.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	МО.Наименование";
	Запрос.УстановитьПараметр("Районы", Районы);
	
	МОПоРайонам = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если МОПоРайонам.Получить(Выборка.РайонЭлектросетей) = Неопределено Тогда
			МОПоРайонам.Вставить(Выборка.РайонЭлектросетей, Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;
	
	ПустоеМО = Справочники.УТП_МуниципальныеОбразования.ПустаяСсылка();
	
	Для Каждого Район Из Районы Цикл
		Если МОПоРайонам.Получить(Район) = Неопределено Тогда
			МОПоРайонам.Вставить(Район, ПустоеМО);
		КонецЕсли;
	КонецЦикла;
	
	Возврат МОПоРайонам;
	
КонецФункции
