// Выборка BIDID из внешнего источника (таблица BID), которых нет в Документ.ЭЭ_ЗаявкаТП.
// Связь: ЭЭ_ЗаявкаТП.ИБР_Основание = BID.BIDID.
// Линейный код без процедур и функций — для консоли кода / "Выполнить".
// Запрос 1С не соединяет таблицы внешнего источника с таблицами конфигурации в одном запросе,
// поэтому BID выгружается в ТЗ и кладётся во временную таблицу через
// ИБР_ВБО_ОбщегоНазначенияСервер.ВременаяТаблицаЗапроса (как в ЗаявкиКадастрУник).

ИмяИсточника = "MySQL_BID"; // имя внешнего источника данных в конфигурации

// ---------- Заявки из BID ----------
Запрос = Новый Запрос;
Запрос.Текст = СтрЗаменить(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	BID.BIDID КАК BIDID
	|ИЗ
	|	ВнешнийИсточникДанных.#Источник#.Таблица.BID КАК BID
	|ГДЕ
	|	НЕ BID.BIDID ЕСТЬ NULL",
	"#Источник#", ИмяИсточника);

РезультатЗапроса = Запрос.Выполнить();
BID_тз = РезультатЗапроса.Выгрузить();

Сообщить("Всего заявок в BID: " + BID_тз.Количество());

// ---------- Отсутствующие в ЭЭ_ЗаявкаТП ----------
Запрос = Новый Запрос;
ИБР_ВБО_ОбщегоНазначенияСервер.ВременаяТаблицаЗапроса(BID_тз, "BID", Запрос);
Запрос.Выполнить();

Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	BID_вт.BIDID КАК BIDID
	|ИЗ
	|	BID_вт КАК BID_вт
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭЭ_ЗаявкаТП КАК ЗаявкаТП
	|		ПО BID_вт.BIDID = ЗаявкаТП.ИБР_Основание
	|ГДЕ
	|	ЗаявкаТП.Ссылка ЕСТЬ NULL
	|
	|УПОРЯДОЧИТЬ ПО
	|	BIDID";

РезультатЗапроса = Запрос.Выполнить();
Отсутствующие_тз = РезультатЗапроса.Выгрузить();

Сообщить("BIDID, которых нет в ЭЭ_ЗаявкаТП: " + Отсутствующие_тз.Количество());

Для Каждого СтрокаТЗ Из Отсутствующие_тз Цикл
	Сообщить(СтрокаТЗ.BIDID);
КонецЦикла;
