// Подсчёт заявок из внешнего источника данных (таблица BID), которых нет в Документ.ЭЭ_ЗаявкаТП.
// Связь: ЭЭ_ЗаявкаТП.ИБР_Основание = BID.BIDID.
// Линейный код без процедур и функций — для консоли кода / "Выполнить".
// Запрос 1С не соединяет таблицы внешнего источника с таблицами конфигурации,
// поэтому оба набора читаются отдельными запросами и сравниваются через Соответствие.

// ---------- Настройки ----------
ИмяИсточника   = "MySQL_BID"; // имя внешнего источника данных в конфигурации
ВыводитьСписок = Истина;

// ---------- Подключение к внешнему источнику ----------
МенеджерИсточника = ВнешниеИсточникиДанных[ИмяИсточника];
Если МенеджерИсточника.ПолучитьСостояние() <> СостояниеВнешнегоИсточникаДанных.Подключен Тогда
	МенеджерИсточника.УстановитьСоединение();
КонецЕсли;

// ---------- Основания, уже загруженные в ЭЭ_ЗаявкаТП ----------
ЗапросДок = Новый Запрос;
ЗапросДок.Текст =
"ВЫБРАТЬ РАЗЛИЧНЫЕ
|	Док.ИБР_Основание КАК Основание
|ИЗ
|	Документ.ЭЭ_ЗаявкаТП КАК Док";

ЕстьВЗаявкахТП = Новый Соответствие;
ВыборкаДок = ЗапросДок.Выполнить().Выбрать();
Пока ВыборкаДок.Следующий() Цикл
	Значение = ВыборкаДок.Основание;
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Ключ = Формат(Значение, "ЧН=0; ЧГ=0");
	Иначе
		Ключ = СокрЛП(Строка(Значение));
	КонецЕсли;
	Если ЗначениеЗаполнено(Ключ) Тогда
		ЕстьВЗаявкахТП.Вставить(Ключ, Истина);
	КонецЕсли;
КонецЦикла;

// ---------- Заявки из BID ----------
ЗапросBID = Новый Запрос;
ЗапросBID.Текст = СтрЗаменить(
"ВЫБРАТЬ РАЗЛИЧНЫЕ
|	Т.BIDID КАК BIDID
|ИЗ
|	ВнешнийИсточникДанных.#Источник#.Таблица.BID КАК Т
|ГДЕ
|	НЕ Т.BIDID ЕСТЬ NULL
|
|УПОРЯДОЧИТЬ ПО
|	BIDID",
	"#Источник#", ИмяИсточника);

ВсегоBID      = 0;
Отсутствующие = Новый Массив;

ВыборкаBID = ЗапросBID.Выполнить().Выбрать();
Пока ВыборкаBID.Следующий() Цикл
	ВсегоBID = ВсегоBID + 1;
	Значение = ВыборкаBID.BIDID;
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Ключ = Формат(Значение, "ЧН=0; ЧГ=0");
	Иначе
		Ключ = СокрЛП(Строка(Значение));
	КонецЕсли;
	Если ЕстьВЗаявкахТП[Ключ] = Неопределено Тогда
		Отсутствующие.Добавить(Ключ);
	КонецЕсли;
КонецЦикла;

Сообщить("Всего заявок в BID: " + ВсегоBID);
Сообщить("Заявок из BID, которых нет в ЭЭ_ЗаявкаТП: " + Отсутствующие.Количество());

Если ВыводитьСписок Тогда
	Для Каждого BIDID Из Отсутствующие Цикл
		Сообщить(BIDID);
	КонецЦикла;
КонецЕсли;
