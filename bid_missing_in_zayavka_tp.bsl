// Подсчёт заявок из MySQL (таблица BID), которых нет в Документ.ЭЭ_ЗаявкаТП.
// Линейный код без процедур и функций — для консоли кода / "Выполнить".
// Выполнять на стороне, где установлен MySQL ODBC-драйвер (Windows, COM ADODB).

// ---------- Настройки ----------
СтрокаПодключения = "Driver={MySQL ODBC 8.0 Unicode Driver};"
	+ "Server=127.0.0.1;Port=3306;Database=имя_базы;"
	+ "User=пользователь;Password=пароль;Option=3;CharSet=utf8mb4;";

ТекстЗапросаMySQL = "SELECT DISTINCT id FROM BID WHERE id IS NOT NULL";
ИмяПоляMySQL      = "id";

// Реквизит документа ЭЭ_ЗаявкаТП, в котором хранится идентификатор заявки из BID.
// Должен быть строкой ограниченной длины (или замените тип колонки ниже).
ИмяРеквизитаСвязи = "ИдентификаторЗаявки";
ДлинаИдентификатора = 50;
ВыводитьСписок      = Истина;

// ---------- Чтение заявок из MySQL ----------
ТаблицаBID = Новый ТаблицаЗначений;
ТаблицаBID.Колонки.Добавить("Идентификатор",
	Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(ДлинаИдентификатора)));

Соединение = Новый COMОбъект("ADODB.Connection");
Соединение.ConnectionTimeout = 30;
Соединение.CommandTimeout    = 600;

Попытка
	Соединение.Open(СтрокаПодключения);
	НаборЗаписей = Соединение.Execute(ТекстЗапросаMySQL);
	
	Пока Не НаборЗаписей.EOF Цикл
		Значение = НаборЗаписей.Fields(ИмяПоляMySQL).Value;
		Если Значение <> Null Тогда
			Если ТипЗнч(Значение) = Тип("Число") Тогда
				Значение = Формат(Значение, "ЧГ=0");
			КонецЕсли;
			НоваяСтрока = ТаблицаBID.Добавить();
			НоваяСтрока.Идентификатор = СокрЛП(Строка(Значение));
		КонецЕсли;
		НаборЗаписей.MoveNext();
	КонецЦикла;
	
	НаборЗаписей.Close();
	Соединение.Close();
Исключение
	Сообщить("Ошибка работы с MySQL: " + ОписаниеОшибки());
	Попытка
		Соединение.Close();
	Исключение
	КонецПопытки;
	ВызватьИсключение;
КонецПопытки;

Сообщить("Всего заявок в BID: " + ТаблицаBID.Количество());

// ---------- Сравнение с Документ.ЭЭ_ЗаявкаТП ----------
Запрос = Новый Запрос;
Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
Запрос.УстановитьПараметр("ТаблицаBID", ТаблицаBID);

ТекстЗапроса =
"ВЫБРАТЬ РАЗЛИЧНЫЕ
|	Т.Идентификатор КАК Идентификатор
|ПОМЕСТИТЬ ВТ_BID
|ИЗ
|	&ТаблицаBID КАК Т
|
|ИНДЕКСИРОВАТЬ ПО
|	Идентификатор
|;
|
|////////////////////////////////////////////////////////////////////////////////
|ВЫБРАТЬ
|	ВТ_BID.Идентификатор КАК Идентификатор
|ИЗ
|	ВТ_BID КАК ВТ_BID
|ГДЕ
|	НЕ ВТ_BID.Идентификатор В
|				(ВЫБРАТЬ
|					Док.#РеквизитСвязи#
|				ИЗ
|					Документ.ЭЭ_ЗаявкаТП КАК Док)
|
|УПОРЯДОЧИТЬ ПО
|	Идентификатор";

Запрос.Текст = СтрЗаменить(ТекстЗапроса, "#РеквизитСвязи#", ИмяРеквизитаСвязи);
Отсутствующие = Запрос.Выполнить().Выгрузить();

Сообщить("Заявок из BID, которых нет в ЭЭ_ЗаявкаТП: " + Отсутствующие.Количество());

Если ВыводитьСписок Тогда
	Для Каждого СтрокаТЗ Из Отсутствующие Цикл
		Сообщить(СтрокаТЗ.Идентификатор);
	КонецЦикла;
КонецЕсли;
