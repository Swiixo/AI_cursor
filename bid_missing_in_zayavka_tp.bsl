// Подсчёт заявок из внешнего источника данных (таблица BID), которых нет в Документ.ЭЭ_ЗаявкаТП.
// Линейный код без процедур и функций — для консоли кода / "Выполнить".
// Запрос 1С не умеет соединять таблицы внешнего источника с таблицами конфигурации,
// поэтому BID сначала выгружается в таблицу значений, а затем передаётся в запрос параметром.

// ---------- Настройки ----------
ИмяИсточника        = "MySQL_BID";           // имя внешнего источника данных в конфигурации
ИмяТаблицыИсточника = "BID";                 // имя таблицы внешнего источника в метаданных
ИмяПоляИдентификатора = "id";                // поле таблицы BID с идентификатором заявки
ИмяРеквизитаСвязи   = "ИдентификаторЗаявки"; // реквизит ЭЭ_ЗаявкаТП, где хранится id из BID
ДлинаИдентификатора = 50;
ВыводитьСписок      = Истина;

// ---------- Подключение к внешнему источнику ----------
МенеджерИсточника = ВнешниеИсточникиДанных[ИмяИсточника];
Если МенеджерИсточника.ПолучитьСостояние() <> СостояниеВнешнегоИсточникаДанных.Подключен Тогда
	МенеджерИсточника.УстановитьСоединение();
КонецЕсли;

// ---------- Чтение заявок из BID ----------
ЗапросBID = Новый Запрос;
ЗапросBID.Текст = СтрЗаменить(СтрЗаменить(СтрЗаменить(
"ВЫБРАТЬ РАЗЛИЧНЫЕ
|	Т.#Поле# КАК Идентификатор
|ИЗ
|	ВнешнийИсточникДанных.#Источник#.Таблица.#Таблица# КАК Т
|ГДЕ
|	НЕ Т.#Поле# ЕСТЬ NULL",
	"#Источник#", ИмяИсточника),
	"#Таблица#", ИмяТаблицыИсточника),
	"#Поле#", ИмяПоляИдентификатора);

ВыборкаBID = ЗапросBID.Выполнить().Выбрать();

ТаблицаBID = Новый ТаблицаЗначений;
ТаблицаBID.Колонки.Добавить("Идентификатор",
	Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(ДлинаИдентификатора)));

Пока ВыборкаBID.Следующий() Цикл
	Значение = ВыборкаBID.Идентификатор;
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Значение = Формат(Значение, "ЧГ=0");
	КонецЕсли;
	ТаблицаBID.Добавить().Идентификатор = СокрЛП(Строка(Значение));
КонецЦикла;

Сообщить("Всего заявок в BID: " + ТаблицаBID.Количество());

// ---------- Сравнение с Документ.ЭЭ_ЗаявкаТП ----------
Запрос = Новый Запрос;
Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
Запрос.УстановитьПараметр("ТаблицаBID", ТаблицаBID);

Запрос.Текст = СтрЗаменить(
"ВЫБРАТЬ РАЗЛИЧНЫЕ
|	Т.Идентификатор КАК Идентификатор
|ПОМЕСТИТЬ ВТ_BID
|ИЗ
|	&ТаблицаBID КАК Т
|
|ИНДЕКСИРОВАТЬ ПО
|	Идентификатор
|;
|
|////////////////////////////////////////////////////////////////////////////////
|ВЫБРАТЬ
|	ВТ_BID.Идентификатор КАК Идентификатор
|ИЗ
|	ВТ_BID КАК ВТ_BID
|ГДЕ
|	НЕ ВТ_BID.Идентификатор В
|				(ВЫБРАТЬ
|					Док.#РеквизитСвязи#
|				ИЗ
|					Документ.ЭЭ_ЗаявкаТП КАК Док)
|
|УПОРЯДОЧИТЬ ПО
|	Идентификатор",
	"#РеквизитСвязи#", ИмяРеквизитаСвязи);

Отсутствующие = Запрос.Выполнить().Выгрузить();

Сообщить("Заявок из BID, которых нет в ЭЭ_ЗаявкаТП: " + Отсутствующие.Количество());

Если ВыводитьСписок Тогда
	Для Каждого СтрокаТЗ Из Отсутствующие Цикл
		Сообщить(СтрокаТЗ.Идентификатор);
	КонецЦикла;
КонецЕсли;
