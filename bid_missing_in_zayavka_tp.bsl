// Выборка BIDID из КрымMySQL (таблица BID), которых нет в Документ.ЭЭ_ЗаявкаТП,
// полученных из источника "БазаMySQL".
// Связь: ЭЭ_ЗаявкаТП.ИБР_Основание = BID.BIDID.
// Линейный код без процедур и функций — для консоли кода / "Выполнить".
// Запрос 1С не соединяет таблицы внешнего источника с таблицами конфигурации в одном запросе,
// поэтому BID выгружается в ТЗ и кладётся во временную таблицу через
// ИБР_ВБО_ОбщегоНазначенияСервер.ВременаяТаблицаЗапроса.

// ---------- Заявки из BID ----------
ЗапросBID = Новый Запрос;
ЗапросBID.Текст = 
	"ВЫБРАТЬ
	|	BID.BIDID КАК BIDID
	|ИЗ
	|	ВнешнийИсточникДанных.КрымMySQL.Таблица.BID КАК BID
	|
	|УПОРЯДОЧИТЬ ПО
	|	BIDID";

BID_тз = ЗапросBID.Выполнить().Выгрузить();

Сообщить("Всего заявок в BID: " + BID_тз.Количество());

// ---------- Отсутствующие в ЭЭ_ЗаявкаТП ----------
Запрос = Новый Запрос;
ИБР_ВБО_ОбщегоНазначенияСервер.ВременаяТаблицаЗапроса(BID_тз, "BID", Запрос);
Запрос.Выполнить();

Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	BID_вт.BIDID КАК BIDID
	|ИЗ
	|	BID_вт КАК BID_вт
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭЭ_ЗаявкаТП КАК Док
	|		ПО BID_вт.BIDID = Док.ИБР_Основание
	|			И (Док.ЗаявкаПолученаССайта = &ЗаявкаПолученаССайта)
	|ГДЕ
	|	Док.Ссылка ЕСТЬ NULL
	|
	|УПОРЯДОЧИТЬ ПО
	|	BIDID";
Запрос.УстановитьПараметр("ЗаявкаПолученаССайта", Справочники.УТП_ИсточникиЗаявок.БазаMySQL);

Отсутствующие_тз = Запрос.Выполнить().Выгрузить();

Сообщить("BIDID, которых нет в ЭЭ_ЗаявкаТП: " + Отсутствующие_тз.Количество());

Для Каждого СтрокаТЗ Из Отсутствующие_тз Цикл
	Сообщить(СтрокаТЗ.BIDID);
КонецЦикла;
