// Выборка BIDID из КрымMySQL (таблица BID), которых нет в Документ.ЭЭ_ЗаявкаТП,
// полученных из источника "БазаMySQL".
// Связь: ЭЭ_ЗаявкаТП.ИБР_Основание = BID.BIDID.
// Порядок: ЭЭ_ЗаявкаТП -> ТЗ -> отбор из внешнего источника по НЕ В (&Массив).
// Линейный код без процедур и функций — для консоли кода / "Выполнить".

// ---------- Основания из ЭЭ_ЗаявкаТП ----------
ЗапросДок = Новый Запрос;
ЗапросДок.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Док.ИБР_Основание КАК ИБР_Основание
	|ИЗ
	|	Документ.ЭЭ_ЗаявкаТП КАК Док
	|ГДЕ
	|	Док.ЗаявкаПолученаССайта = &ЗаявкаПолученаССайта";
ЗапросДок.УстановитьПараметр("ЗаявкаПолученаССайта", Справочники.УТП_ИсточникиЗаявок.БазаMySQL);

ЗаявкиТП_тз = ЗапросДок.Выполнить().Выгрузить();

Основания = Новый Массив;
Для Каждого СтрокаТЗ Из ЗаявкиТП_тз Цикл
	Если ЗначениеЗаполнено(СтрокаТЗ.ИБР_Основание) Тогда
		Основания.Добавить(СтрокаТЗ.ИБР_Основание);
	КонецЕсли;
КонецЦикла;

Сообщить("Заявок ТП из БазаMySQL (уникальных оснований): " + Основания.Количество());

// ---------- Отбор из внешнего источника ----------
ЗапросBID = Новый Запрос;
ЗапросBID.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	BID.BIDID КАК BIDID
	|ИЗ
	|	ВнешнийИсточникДанных.КрымMySQL.Таблица.BID КАК BID
	|ГДЕ
	|	НЕ BID.BIDID В (&Основания)
	|
	|УПОРЯДОЧИТЬ ПО
	|	BIDID";
ЗапросBID.УстановитьПараметр("Основания", Основания);

Отсутствующие_тз = ЗапросBID.Выполнить().Выгрузить();

Сообщить("BIDID, которых нет в ЭЭ_ЗаявкаТП: " + Отсутствующие_тз.Количество());

Для Каждого СтрокаТЗ Из Отсутствующие_тз Цикл
	Сообщить(СтрокаТЗ.BIDID);
КонецЦикла;
